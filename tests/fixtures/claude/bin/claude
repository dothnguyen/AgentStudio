#!/usr/bin/env python3
"""Test stand-in for Claude Code 2.1.307 in `-p --output-format stream-json` mode. Emits the event shapes captured
from the real CLI (see ../*.jsonl) and honours --tools / --permission-mode for file writes. Controlled by
fake-claude.json next to this file; appends each run to calls.jsonl next to this file."""
import json
import os
import re
import sys
import time
import uuid

HERE = os.path.dirname(os.path.abspath(__file__))
try:
    with open(os.path.join(HERE, "fake-claude.json")) as f:
        CTL = json.load(f)
except (OSError, ValueError):
    CTL = {}
FLAGS = ("--print", "--output-format", "--verbose", "--permission-mode", "--permission-prompts", "--tools",
         "--allowedTools", "--strict-mcp-config", "--restricted", "--no-session-persistence", "--model", "--effort")
HELP = "Usage: claude [options] [command] [prompt]\n" + "\n".join(f"  {f} <x>" for f in FLAGS if f not in CTL.get("dropFlags", [])) + \
    '\n  --permission-mode <mode>  (choices: "acceptEdits", "auto", "bypassPermissions", "manual", "dontAsk", "plan")\n'
SID = str(uuid.uuid4())


def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def assistant(content):
    out({"type": "assistant", "message": {"id": "msg_x", "type": "message", "role": "assistant", "model": MODEL,
                                          "content": content, "stop_reason": None}, "session_id": SID})


def tool_result(tid, text, is_error):
    out({"type": "user", "message": {"role": "user", "content": [
        {"tool_use_id": tid, "type": "tool_result", "content": text, "is_error": is_error}]}, "session_id": SID})


def result(text, is_error=False, denials=(), reason="completed"):
    out({"type": "result", "subtype": "success", "is_error": is_error, "result": text, "session_id": SID,
         "permission_denials": list(denials), "terminal_reason": reason, "num_turns": 2, "total_cost_usd": 0.0003,
         "usage": {"input_tokens": 50, "output_tokens": 5, "cache_read_input_tokens": 0}})


def opt(argv, name):
    return argv[argv.index(name) + 1] if name in argv else None


argv = sys.argv[1:]
if argv[:1] == ["--version"]:
    print(CTL.get("version", "2.1.307") + " (Claude Code)")
    sys.exit(0)
if argv[:1] == ["--help"]:
    print(HELP)
    sys.exit(0)
LOGGED_OUT = CTL.get("loggedOut") or (os.environ.get("CLAUDE_CONFIG_DIR") and not os.path.exists(
    os.path.join(os.environ["CLAUDE_CONFIG_DIR"], ".credentials.json")))
if argv[:2] == ["auth", "status"]:
    CTL["loggedOut"] = LOGGED_OUT
    print(json.dumps({"loggedIn": not CTL.get("loggedOut"), "authMethod": None if CTL.get("loggedOut") else "claude.ai",
                      "apiProvider": "firstParty"}, indent=2))
    sys.exit(1 if CTL.get("loggedOut") else 0)
if "--print" not in argv:
    sys.exit(2)
if opt(argv, "--output-format") == "stream-json" and "--verbose" not in argv:
    print("Error: When using --print, --output-format=stream-json requires --verbose", file=sys.stderr)
    sys.exit(1)
prompt = sys.stdin.read()
MODEL = opt(argv, "--model") or "claude-default"
tools = (opt(argv, "--tools") or "").split(",")
mode = opt(argv, "--permission-mode")
allowed = (opt(argv, "--allowedTools") or "").split(",")
cwd = os.getcwd()
with open(os.path.join(HERE, "calls.jsonl"), "a") as f:
    f.write(json.dumps({"argv": argv, "prompt": prompt, "cwd": cwd, "model": opt(argv, "--model"),
                        "effort": opt(argv, "--effort"), "mode": mode, "tools": tools}) + "\n")
out({"type": "system", "subtype": "init", "cwd": cwd, "session_id": SID, "tools": tools, "mcp_servers": [],
     "model": MODEL, "permissionMode": mode, "claude_code_version": "2.1.307"})
if CTL.get("mode") == "loggedOutRun":
    assistant([{"type": "text", "text": "Not logged in · Please run /login"}])
    result("Not logged in · Please run /login", is_error=True, reason="api_error")
    sys.exit(1)
if CTL.get("mode") == "api_error":
    assistant([{"type": "text", "text": "API Error: 400 Internal server error"}])
    result("API Error: 400 Internal server error", is_error=True, reason="api_error")
    sys.exit(1)
if CTL.get("mode") == "hang":
    time.sleep(3600)
reply = "ok"
if "at least 400 words" in prompt:  # the live gate's slow task
    time.sleep(float(CTL.get("slowSeconds", 10)))
if "Reviewer in an Agent Studio workflow" in prompt or re.search(r"(STORY BEFORE WORK|QA REVIEW|FINAL REVIEW)", prompt):
    reply = '{"verdict": "pass", "findings": []}'
    if "FINAL REVIEW" in prompt:
        reply = "Looks good.\n```commit\nImplement the story\n\nStand-in commit body.\n```\n" + reply
if re.search(r"(Implement the story|Fix the QA findings)", prompt) and "Write" in tools:
    with open(os.path.join(cwd, "impl.txt"), "a") as f:
        f.write("implemented\n")
    reply = "Implemented."
m = re.search(r"Create a file named (\S+) in the current directory", prompt)
if m:
    name, tid = m.group(1), "toolu_" + uuid.uuid4().hex[:20]
    body = re.search(r"single line (\S+)", prompt)
    path = os.path.join(cwd, name)
    assistant([{"type": "tool_use", "id": tid, "name": "Write", "input": {"file_path": path, "content": "x"}}])
    if "Write" not in tools:
        tool_result(tid, "<tool_use_error>Error: No such tool available: Write.</tool_use_error>", True)
        reply = "I cannot write files in this session."
    elif mode == "acceptEdits" or "Write" in allowed:
        with open(path, "w") as f:
            f.write((body.group(1) if body else "x") + "\n")
        tool_result(tid, f"File created successfully at: {path}", None)
        reply = "DONE"
    else:
        out({"type": "system", "subtype": "permission_denied", "tool_name": "Write", "tool_use_id": tid,
             "decision_reason": "don't ask mode", "session_id": SID})
        tool_result(tid, "Permission to use Write has been denied because Claude Code is running in don't ask mode.", True)
        assistant([{"type": "text", "text": "Permission was denied."}])
        result("Permission was denied.", denials=[{"tool_name": "Write", "tool_use_id": tid,
                                                    "tool_input": {"file_path": path, "content": "x"}}])
        sys.exit(0)
m = re.search(r"Reply with exactly (\S+) and nothing else", prompt)
if m:
    reply = m.group(1)
m = re.search(r"nothing else: (\{.*\})", prompt)
if m:
    reply = m.group(1)
assistant([{"type": "text", "text": reply}])
result(reply)
