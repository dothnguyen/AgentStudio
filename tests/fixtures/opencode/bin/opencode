#!/usr/bin/env python3
"""Test stand-in for opencode v2.2.5 in `run --format json` mode. Emits the event shapes captured from the
real CLI (see ../captured-2.2.5-*.jsonl) plus the older v2.1.4 shapes. Honours --log-level/--format/--model
and OPENCODE_CONFIG_CONTENT (via `debug --standalone agents`, the adapter's injection canary). Controlled by
fake-opencode.json next to this file; appends each run to calls.jsonl next to this file."""
import json
import os
import sys
import uuid

HERE = os.path.dirname(os.path.abspath(__file__))
try:
    with open(os.path.join(HERE, "fake-opencode.json")) as f:
        CTL = json.load(f)
except (OSError, ValueError):
    CTL = {}
FLAGS = ("--standalone", "--server", "--continue", "--session", "--fork", "--model", "--agent", "--format",
         "--file", "--title", "--thinking", "--auto", "--log-level", "--print-logs")
HELP = ("DESCRIPTION\n  Run OpenCode with a message\n\nUSAGE\n  opencode run [flags] [<message...>]\n\nFLAGS\n"
        + "\n".join(f"  {f} string" for f in FLAGS
                    if f not in CTL.get("dropFlags", []) and f not in ("--continue", "--auto"))
        + "\n  --continue, -c          Continue the last session\n"
        + "\n  --auto                  Auto-approve permissions that are not explicitly denied\n"
        + "\n  --format choice         Output format (choices: default, json)\n")
SID = "ses_" + uuid.uuid4().hex[:20]


def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def emit(kind, part):
    out({"type": kind, "timestamp": 1793451566652, "sessionID": SID, "part": part})


def start():
    emit("step_start", {"id": "prt_1", "sessionID": SID, "messageID": "msg_1", "type": "step-start"})


def text(value):
    emit("text", {"id": "prt_text", "sessionID": SID, "messageID": "msg_1", "type": "text", "text": value})


def finish(reason="stop", cost=0.0001, tokens=None):
    emit("step_finish", {"id": "prt_finish", "sessionID": SID, "messageID": "msg_1", "type": "step-finish",
                         "reason": reason, "cost": cost,
                         "tokens": tokens or {"input": 10, "output": 5, "reasoning": 0,
                                              "cache": {"read": 0, "write": 0}}})


def main():
    prompt = sys.stdin.buffer.read()
    args = sys.argv[1:]
    if "--version" in args:
        sys.stdout.write(CTL.get("versionText", "opencode v2.2.5") + "\n")
        return 0
    if "debug" in args:
        if CTL.get("noConfigInjection"):
            sys.stdout.write(json.dumps([{"id": "build", "permissions": []}]))
            return 0
        config = json.loads(os.environ.get("OPENCODE_CONFIG_CONTENT") or "{}")
        rules = [{"action": "*", "resource": "*", "effect": "allow"}] + list(config.get("permissions") or [])
        sys.stdout.write(json.dumps([{"id": "build", "permissions": rules}]))
        return 0
    if "--help" in args or "run" not in args:
        sys.stdout.write(HELP)
        return 0
    if "--format" not in args:
        sys.stderr.write("format required by the adapter\n")
        return 2
    with open(os.path.join(HERE, "calls.jsonl"), "a") as f:
        f.write(json.dumps({"argv": args, "promptBytes": len(prompt),
                            "config": os.environ.get("OPENCODE_CONFIG_CONTENT")}) + "\n")
    scenario = CTL.get("scenario", "provider_auth")
    start()
    if scenario == "provider_auth":
        out({"type": "error", "timestamp": 1792931707318, "sessionID": SID,
             "error": {"type": "provider.auth", "status": 403,
                       "message": "Upstream request failed: An active OpenCode Go subscription is required "
                                  "to use Go models.",
                       "response": {"body": "{}"}}})
        return 0  # verified: the real CLI exits 0 on a provider error
    if scenario == "invalid_request":
        out({"type": "error", "timestamp": 1792931922407, "sessionID": SID,
             "error": {"type": "provider.invalid-request", "status": 400,
                       "message": "Upstream request failed: privacy settings.",
                       "response": {"body": "{}"}}})
        return 0
    if scenario == "limit":
        out({"type": "error", "timestamp": 1793451236762, "sessionID": SID,
             "error": {"type": "provider.free-limit", "status": 429,
                       "message": "Free usage limit reached. Connect a provider or subscribe to OpenCode Go "
                                  "to keep going, or switch models.",
                       "response": {"body": "{}"}}, "retryAfterMs": 39964000})
        return 0
    if scenario == "success":
        text(CTL.get("finalText", "AGENT_STUDIO_OK"))
        finish()
        return 0
    if scenario == "tool_success":
        emit("tool_use", {"partID": "prt_tool", "sessionID": SID, "messageID": "msg_1", "type": "tool",
                          "id": "call_1", "tool": "write",
                          "state": {"status": "completed", "input": {"path": "made.txt", "content": "hi\n"},
                                    "output": "Wrote made.txt", "title": "write",
                                    "time": {"start": 1, "end": 2}}})
        finish("tool-calls")
        start()
        text("DONE")
        finish()
        return 0
    if scenario == "tool_denied":
        emit("tool_use", {"partID": "prt_tool", "sessionID": SID, "messageID": "msg_1", "type": "tool",
                          "id": "call_1", "tool": "write",
                          "state": {"status": "error", "input": {"path": "made.txt"},
                                    "error": "Permission denied: edit", "time": {"start": 1, "end": 2}}})
        finish("tool-calls")
        start()
        text("I could not create the file.")
        finish()
        return 0
    if scenario == "legacy_tool_denied":
        emit("tool_use", {"id": "prt_tool", "sessionID": SID, "messageID": "msg_1", "type": "tool",
                          "tool": "bash", "state": "error", "error": "permission denied by policy"})
        text("I could not run the command.")
        finish()
        return 0
    if scenario == "no_final":
        return 0  # stream ends with no terminal event -> inconclusive
    if scenario == "garbage":
        sys.stdout.write("this line is not json\n")
        sys.stdout.write('{"type": "step_start", "truncated')
        return 0
    out({"type": "error", "timestamp": 1, "sessionID": SID,
         "error": {"type": "provider.invalid-request", "status": 400, "message": f"unknown scenario {scenario}",
                   "response": {"body": "{}"}}})
    return 0


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "auth":
        # opencode auth list: one "<provider>  <name>  stored" line per credential
        stored = CTL.get("authStored", True)
        if stored:
            print("OpenCode Go  OpenCode Go                 stored")
        sys.exit(0)
    sys.exit(main())
