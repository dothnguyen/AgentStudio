#!/usr/bin/env python3
"""Test stand-in for opencode v2.1.4 in `run --format json` mode. Emits the event shapes captured from the
real CLI (see ../*.jsonl for the captured error events) plus the documented success shapes; honours
--log-level/--format/--model. Controlled by fake-opencode.json next to this file; appends each run to
calls.jsonl next to this file."""
import json
import os
import sys
import uuid

HERE = os.path.dirname(os.path.abspath(__file__))
try:
    with open(os.path.join(HERE, "fake-opencode.json")) as f:
        CTL = json.load(f)
except (OSError, ValueError):
    CTL = {}
FLAGS = ("--standalone", "--server", "--continue", "--session", "--fork", "--model", "--agent", "--format",
         "--file", "--title", "--thinking", "--auto", "--log-level", "--print-logs")
HELP = ("DESCRIPTION\n  Run OpenCode with a message\n\nUSAGE\n  opencode run [flags] [<message...>]\n\nFLAGS\n"
        + "\n".join(f"  {f} string" for f in FLAGS
                    if f not in CTL.get("dropFlags", []) and f not in ("--continue", "--auto"))
        + "\n  --continue, -c          Continue the last session\n"
        + "\n  --auto                  Auto-approve permissions that are not explicitly denied\n")
SID = "ses_" + uuid.uuid4().hex[:20]


def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def main():
    prompt = sys.stdin.buffer.read()
    if "--version" in sys.argv[1:]:
        sys.stdout.write(CTL.get("versionText", "opencode v2.1.4") + "\n")
        return 0
    if "--help" in sys.argv[1:] or "run" not in sys.argv[1:]:
        sys.stdout.write(HELP)
        return 0
    if "--format" not in sys.argv[1:]:
        sys.stderr.write("format required by the adapter\n")
        return 2
    with open(os.path.join(HERE, "calls.jsonl"), "a") as f:
        f.write(json.dumps({"argv": sys.argv[1:], "promptBytes": len(prompt)}) + "\n")
    if CTL.get("authList") is not None and "--help" not in sys.argv[1:]:
        pass  # auth list is a separate subcommand, handled below
    scenario = CTL.get("scenario", "provider_auth")
    out({"type": "step_start", "timestamp": 1792931707301, "sessionID": SID,
         "part": {"id": "prt_1", "sessionID": SID, "messageID": "msg_1", "type": "step-start",
                  "snapshot": "4b825dc642cb6eb9a060e54bf8d69288fbee4904"}})
    if scenario == "provider_auth":
        out({"type": "error", "timestamp": 1792931707318, "sessionID": SID,
             "error": {"type": "provider.auth", "status": 403,
                       "message": "Upstream request failed: An active OpenCode Go subscription is required "
                                  "to use Go models.",
                       "response": {"body": "{}"}}})
        return 0  # verified: the real CLI exits 0 on a provider error
    if scenario == "invalid_request":
        out({"type": "error", "timestamp": 1792931922407, "sessionID": SID,
             "error": {"type": "provider.invalid-request", "status": 400,
                       "message": "Upstream request failed: privacy settings.",
                       "response": {"body": "{}"}}})
        return 0
    if scenario == "success":
        out({"type": "part", "sessionID": SID,
             "part": {"id": "prt_2", "sessionID": SID, "messageID": "msg_2", "type": "text",
                      "text": CTL.get("finalText", "AGENT_STUDIO_OK")}})
        out({"type": "part", "sessionID": SID,
             "part": {"id": "prt_3", "sessionID": SID, "messageID": "msg_2", "type": "step-finish",
                      "tokens": {"input": 10, "output": 5}}})
        return 0
    if scenario == "tool_denied":
        out({"type": "part", "sessionID": SID,
             "part": {"id": "prt_4", "sessionID": SID, "messageID": "msg_3", "type": "tool",
                      "tool": "bash", "state": "error", "error": "permission denied by policy"}})
        out({"type": "part", "sessionID": SID,
             "part": {"id": "prt_5", "sessionID": SID, "messageID": "msg_3", "type": "text",
                      "text": "I could not run the command."}})
        out({"type": "part", "sessionID": SID,
             "part": {"id": "prt_6", "sessionID": SID, "messageID": "msg_3", "type": "step-finish",
                      "tokens": {"input": 12, "output": 8}}})
        return 0
    if scenario == "no_final":
        return 0  # stream ends with no terminal event -> inconclusive
    if scenario == "garbage":
        sys.stdout.write("this line is not json\n")
        sys.stdout.write('{"type": "step_start", "truncated')
        return 0
    out({"type": "error", "timestamp": 1, "sessionID": SID,
         "error": {"type": "provider.invalid-request", "status": 400, "message": f"unknown scenario {scenario}",
                   "response": {"body": "{}"}}})
    return 0


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "auth":
        # opencode auth list: one "<name>  <name>  stored" line per credential
        stored = CTL.get("authStored", True)
        if stored:
            print("OpenCode Go  OpenCode Go                 stored")
        sys.exit(0)
    sys.exit(main())
