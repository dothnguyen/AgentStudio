{
  "name": "agent-studio-app",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Studio desktop app (Electron)",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "live-check": "npm run build && node dist/live/liveCheck.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "electron": "45.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
