{
  "version": 1,
  "defaults": {
    "timeoutMs": 900000,
    "network": false,
    "approval": "auto",
    "maxPerVisit": 2,
    "maxPerRun": 6,
    "trackedChanges": "forbid"
  },
  "onDenialWithRequest": "delegate",
  "commands": {
    "app-deps-install": {
      "description": "Install the app's npm dependencies for this platform from package-lock.json (deletes and rebuilds app/node_modules).",
      "argv": [
        "npm",
        "ci"
      ],
      "cwd": "app",
      "env": {
        "ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
      },
      "network": true,
      "roles": [
        "Developer",
        "SeniorDeveloper",
        "QA"
      ]
    },
    "app-deps-rebuild": {
      "description": "Rebuild native modules in app/node_modules for this platform.",
      "argv": [
        "npm",
        "rebuild"
      ],
      "cwd": "app",
      "roles": [
        "Developer",
        "SeniorDeveloper",
        "QA"
      ]
    },
    "app-dev-dependency-add": {
      "description": "Add one dev dependency to app/package.json and package-lock.json.",
      "argv": [
        "npm",
        "install",
        "--save-dev",
        "{package}"
      ],
      "cwd": "app",
      "env": {
        "ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
      },
      "params": {
        "package": {
          "pattern": "(@[a-z0-9-]+/)?[a-z0-9._-]+(@[0-9A-Za-z.^~-]+)?",
          "maxLength": 100,
          "description": "npm package name, optionally @version"
        }
      },
      "network": true,
      "approval": "auto",
      "trackedChanges": "allow",
      "roles": [
        "Developer",
        "SeniorDeveloper"
      ]
    },
    "test-all": {
      "description": "Run the full test suite outside your sandbox: backend unit and integration tests, and app test, typecheck and build (scripts/validate.py --all). A pass verdict needs a successful run on your final code.",
      "argv": [
        "python3",
        "scripts/validate.py",
        "--all"
      ],
      "network": true,
      "timeoutMs": 1500000,
      "maxPerVisit": 8,
      "maxPerRun": 20,
      "roles": [
        "Developer",
        "SeniorDeveloper",
        "QA",
        "Reviewer"
      ]
    },
    "test-touched": {
      "description": "Quicker check while iterating: the unit suite plus the integration modules and app package your change touches (scripts/validate.py --touched). Does not count as the final test run.",
      "argv": [
        "python3",
        "scripts/validate.py",
        "--touched"
      ],
      "network": true,
      "timeoutMs": 1200000,
      "maxPerVisit": 8,
      "maxPerRun": 20,
      "roles": [
        "Developer",
        "SeniorDeveloper",
        "QA",
        "Reviewer"
      ]
    },
    "test-unit": {
      "description": "Fastest check: the backend unit suite only (scripts/validate.py --unit).",
      "argv": [
        "python3",
        "scripts/validate.py",
        "--unit"
      ],
      "timeoutMs": 600000,
      "maxPerVisit": 8,
      "maxPerRun": 20,
      "roles": [
        "Developer",
        "SeniorDeveloper",
        "QA",
        "Reviewer"
      ]
    }
  }
}
