{
  "version": 2,
  "baseBranch": "main",
  "leaseSeconds": 300,
  "agentTicketStatus": "refine-ready",
  "statuses": [
    {
      "id": "backlog",
      "kind": "initial",
      "name": "Backlog"
    },
    {
      "id": "unpack-ready",
      "name": "Unpack ready"
    },
    {
      "id": "refine-ready",
      "name": "Refine ready"
    },
    {
      "id": "dev-ready",
      "name": "Dev ready"
    },
    {
      "id": "qa-ready",
      "name": "QA ready"
    },
    {
      "id": "need-escalate",
      "name": "Needs escalation"
    },
    {
      "id": "review-ready",
      "name": "Review ready"
    },
    {
      "id": "plan-merge-ready",
      "name": "Plan merge ready"
    },
    {
      "id": "plan-merge-conflict",
      "name": "Plan merge conflict"
    },
    {
      "id": "merge-ready",
      "name": "Merge ready"
    },
    {
      "id": "merge-conflict",
      "name": "Merge conflict"
    },
    {
      "id": "done",
      "kind": "done",
      "name": "Done"
    },
    {
      "id": "close",
      "kind": "closed",
      "name": "Close"
    }
  ],
  "ticketFields": [],
  "rules": [
    {
      "when": {
        "status": "merge-ready"
      },
      "action": "merge",
      "onPass": "done",
      "onFail": "merge-conflict",
      "onFailPriority": 0
    },
    {
      "when": {
        "status": "plan-merge-ready"
      },
      "action": "merge",
      "onPass": "done",
      "onFail": "plan-merge-conflict",
      "onFailPriority": 0,
      "onPassCreatedTickets": {
        "from": "backlog",
        "to": "refine-ready"
      }
    },
    {
      "when": {
        "status": "merge-conflict"
      },
      "role": "TeamLead",
      "workflow": "board-resolve-merge",
      "workspace": "worktree",
      "syncBase": true,
      "onPass": "merge-ready",
      "onFail": "merge-conflict",
      "maxRounds": 3,
      "priority": 0
    },
    {
      "when": {
        "status": "plan-merge-conflict"
      },
      "role": "TeamLead",
      "workflow": "board-resolve-merge",
      "workspace": "worktree",
      "syncBase": true,
      "onPass": "plan-merge-ready",
      "onFail": "plan-merge-conflict",
      "maxRounds": 3,
      "priority": 0
    },
    {
      "when": {
        "status": "review-ready"
      },
      "role": "Reviewer",
      "workflow": "board-review",
      "workspace": "worktree",
      "onPass": "merge-ready",
      "onFail": "dev-ready",
      "onFailPriority": 0,
      "maxRounds": 3
    },
    {
      "when": {
        "status": "qa-ready"
      },
      "role": "QA",
      "workflow": "board-qa",
      "workspace": "worktree",
      "onPass": "review-ready",
      "onFail": "dev-ready",
      "onFailPriority": 0,
      "onFailureLimit": { "count": 3, "status": "need-escalate" }
    },
    {
      "when": { "status": "need-escalate" },
      "role": "SeniorDeveloper",
      "workflow": "board-senior-develop",
      "workspace": "worktree",
      "syncBase": true,
      "onPass": "qa-ready",
      "onFail": "need-escalate",
      "maxRounds": 3,
      "priority": 0
    },
    {
      "when": {
        "status": "dev-ready"
      },
      "role": "Developer",
      "workflow": "board-develop",
      "workspace": "worktree",
      "onPass": "qa-ready",
      "onFail": "dev-ready",
      "maxRounds": 6,
      "requiresDeps": true,
      "syncBase": true
    },
    {
      "when": {
        "status": "refine-ready"
      },
      "role": "TeamLead",
      "workflow": "board-refine",
      "workspace": "worktree",
      "onPass": "dev-ready",
      "onFail": "backlog",
      "maxRounds": 2
    },
    {
      "when": {
        "status": "unpack-ready"
      },
      "role": "ProductOwner",
      "workflow": "board-unpack",
      "workspace": "worktree",
      "createdTicketStatus": "backlog",
      "onPass": "plan-merge-ready",
      "onFail": "backlog",
      "maxRounds": 2
    }
  ]
}
